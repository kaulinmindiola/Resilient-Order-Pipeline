# Local development values only. Copy to .env (git-ignored) before running Docker Compose.
# None of these is a real secret: replace them in any shared or deployed environment.

# PostgreSQL superuser, used only by the init script that creates the service roles (ADR-0015).
POSTGRES_PASSWORD=postgres-dev
# Passwords of the per-service database roles (ADR-0002).
ORDER_DB_PASSWORD=order-dev
INVENTORY_DB_PASSWORD=inventory-dev

# API client seeded by Flyway; only the BCrypt hash of its secret is stored (REQ-FUNC-017, REQ-SEC-001).
SEED_CLIENT_ID=demo-client
SEED_CLIENT_SECRET=demo-secret-change-me

# HS256 signing key for access tokens: at least 32 bytes (REQ-SEC-001).
JWT_SIGNING_SECRET=dev-only-jwt-signing-secret-change-me-0123456789

# Optional: outbox polling interval in milliseconds for both services (default 5000).
# OUTBOX_POLLING_INTERVAL_MS=5000
